# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ── Next.js build output ──────────────────────────────────────────────────────
.next/
out/

# ── Sanity generated/build output ────────────────────────────────────────────
# .sanity/ is auto-generated by `sanity dev` on every run — never commit it
.sanity/
# dist/ is the output of `sanity build` (standalone studio build).
# This project uses the embedded studio inside Next.js, so dist/ is never needed.
dist/

# ── Environment variables with secrets ───────────────────────────────────────
# .env is safe to commit (only public project IDs, no tokens).
# .env.local is for secrets that should NEVER be committed (e.g. API tokens).
.env.local
.env*.local
.env
# ── OS / editor noise ─────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
